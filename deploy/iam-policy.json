{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DynamoDBFullAccessApkaAI",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:PutItem",
        "dynamodb:UpdateItem",
        "dynamodb:DeleteItem",
        "dynamodb:Scan",
        "dynamodb:Query",
        "dynamodb:BatchWriteItem",
        "dynamodb:BatchGetItem",
        "dynamodb:DescribeTable"
      ],
      "Resource": [
        "arn:aws:dynamodb:ap-south-1:*:table/apkaai-tools",
        "arn:aws:dynamodb:ap-south-1:*:table/apkaai-tools/index/*",
        "arn:aws:dynamodb:ap-south-1:*:table/apkaai-categories",
        "arn:aws:dynamodb:ap-south-1:*:table/apkaai-contacts"
      ]
    },
    {
      "Sid": "S3AssetsReadWrite",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject",
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::apkaai-assets",
        "arn:aws:s3:::apkaai-assets/*"
      ]
    },
    {
      "Sid": "CloudFrontInvalidation",
      "Effect": "Allow",
      "Action": [
        "cloudfront:CreateInvalidation"
      ],
      "Resource": "*"
    }
  ]
}
