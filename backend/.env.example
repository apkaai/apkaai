# ═══════════════════════════════════════════════════════════════
# ApkaAI Backend — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to Git.
# ═══════════════════════════════════════════════════════════════

# ── Server ────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ── Frontend (CORS + email links) ─────────────────────────────
FRONTEND_URL=https://apkaai.com

# ── PostgreSQL (AWS RDS) ──────────────────────────────────────
DB_HOST=apkaai-db.cl8qcg44s0p7.ap-south-1.rds.amazonaws.com
DB_PORT=5432
DB_NAME=apkaai
DB_USER=apkaai_user
DB_PASS=your_db_password_here
DB_SSL=true

# ── Auth ──────────────────────────────────────────────────────
JWT_SECRET=your_jwt_secret_here_change_in_production
PASSWORD_SALT=your_password_salt_here_change_in_production

# ── AWS Core (IAM role auto-resolves on EC2 — no keys needed in prod) ──
# Only set these for local development / CI.
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here

# ── AWS SES — Email (https://console.aws.amazon.com/ses) ──────
# Step 1: Verify domain apkaai.com in SES console
# Step 2: Verify these sender identities in SES
# Step 3: Request Production Access (out of SES Sandbox)
# Step 4: Add SPF/DKIM/DMARC DNS records in GoDaddy
#
# SES_REGION defaults to AWS_REGION if not set.
SES_REGION=ap-south-1
#
# SES_FROM_EMAIL must be a VERIFIED identity in SES.
# When set, all emails use SES. When unset, SMTP fallback is used.
SES_FROM_EMAIL=no-reply@apkaai.com
#
# Additional verified sender addresses (create in SES console):
SES_BILLING_EMAIL=billing@apkaai.com
SES_SUPPORT_EMAIL=support@apkaai.com
#
# DNS records to add in GoDaddy for apkaai.com:
#   SPF  :  v=spf1 include:amazonses.com ~all
#   DMARC:  v=DMARC1; p=quarantine; rua=mailto:dmarc@apkaai.com
#   DKIM :  (3 CNAME records generated by SES — copy from SES console)

# ── AWS S3 — Invoice Storage ───────────────────────────────────
# Private bucket — NO public access.
# Create bucket: apkaai-invoices-prod (ap-south-1, block all public access)
# Enable: Versioning, SSE-AES256 encryption, lifecycle rules
# IAM policy needed on apkaai-ec2-role:
#   { "Action": ["s3:PutObject","s3:GetObject"], "Resource": "arn:aws:s3:::apkaai-invoices-prod/*" }
S3_INVOICES_BUCKET=apkaai-invoices-prod
#
# Existing assets bucket (logos, images):
S3_ASSETS_BUCKET=apkaai-assets

# ── SMTP Fallback (used when SES_FROM_EMAIL is NOT set) ────────
# Useful for local dev with Gmail or Mailtrap.
# Gmail: enable 2FA → create App Password → use that as SMTP_PASS
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here
SMTP_FROM=ApkaAI <your_email@gmail.com>

# ── Razorpay — Payment Gateway (https://dashboard.razorpay.com) ──
# Test keys start with rzp_test_  |  Live keys start with rzp_live_
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
# Webhook secret — Dashboard → Settings → Webhooks → Add webhook
# URL: https://apkaai.com/api/payment/webhook
# Events: payment.captured, payment.failed
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# ── AWS Pricing API (used by /api/cloud/aws-live-price) ────────
# No extra keys needed on EC2 — IAM role handles it automatically.
# For local dev only:
# AWS_ACCESS_KEY_ID + AWS_SECRET_ACCESS_KEY above cover this too.

# ── Demo Booking System ────────────────────────────────────────────────────────
# The email address of the demo host (receives booking notifications)
DEMO_HOST_EMAIL=ashutoshkumarpandey@apkaai.com

# ── Google Calendar Integration ────────────────────────────────────────────────
# 1. Go to console.cloud.google.com → Create project → Enable Google Calendar API
# 2. IAM & Admin → Service Accounts → Create → Download JSON key
# 3. Share your "ApkaAI Demo" Google Calendar with the service account email
# 4. Paste the entire JSON key as a single-line string below
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"...","client_email":"...@....iam.gserviceaccount.com","client_id":"..."}
#
# The Google Calendar ID to create events on (use 'primary' or a dedicated calendar)
GOOGLE_CALENDAR_ID=primary

# ── Microsoft Teams + Outlook Integration ─────────────────────────────────────
# 1. Go to portal.azure.com → Azure Active Directory → App registrations → New registration
# 2. API permissions → Add: Calendar.ReadWrite + OnlineMeetings.ReadWrite (Application)
# 3. Grant admin consent
# 4. Certificates & secrets → New client secret
MS_TENANT_ID=your-azure-tenant-id-here
MS_CLIENT_ID=your-azure-app-client-id-here
MS_CLIENT_SECRET=your-azure-app-client-secret-here
#
# Azure AD Object ID of the user whose calendar/meetings to create events on
# Go to Azure AD → Users → click user → Object ID
MS_DEMO_HOST_USER_ID=your-azure-user-object-id-here
